# Telegram Bot & Webhook Configuration (Required for Worker)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
WEBHOOK_PUBLIC_BASE_URL=https://your-domain.example
TELEGRAM_WEBHOOK_SECRET=

# OpenAI Configuration (Optional - for GPT summaries)
OPENAI_API_KEY=
OPENAI_SUMMARY_MODEL=gpt-5-mini
OPENAI_SUMMARY_TIMEOUT_SECONDS=20
OPENAI_SUMMARY_MAX_OUTPUT_TOKENS=100
OPENAI_SUMMARY_RETRY_ATTEMPTS=1

# Worker & Database Configuration (Optional defaults)
WORKER_DB_PATH=.data/berlin_insider.db
WORKER_HOST=0.0.0.0
WORKER_PORT=8080
WORKER_TIMEZONE=Europe/Berlin
WORKER_TARGET_ITEMS=7
WORKER_WEEKEND_WEEKDAY=friday
WORKER_DAILY_HOUR=8
WORKER_WEEKEND_HOUR=8

# Optional Webhook network configuration
TELEGRAM_API_BASE=https://api.telegram.org
TELEGRAM_WEBHOOK_CERT_PATH=
TELEGRAM_WEBHOOK_IP=
